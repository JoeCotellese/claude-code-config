{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "joec-config",
  "displayName": "Joe's Claude Code Config",
  "description": "Skills, agents, commands and output styles for spec/implement/submit workflow, Obsidian capture, and platform reviewers.",
  "version": "1.0.0",
  "author": {
    "name": "Joe Cotellese",
    "email": "joe@cotellese.net"
  },
  "repository": "https://github.com/JoeCotellese/claude-code-config",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/atlassian-companion-reminder.sh\""
          }
        ]
      }
    ]
  }
}
