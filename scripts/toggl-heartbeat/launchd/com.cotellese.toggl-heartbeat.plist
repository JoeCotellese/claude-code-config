<?xml version="1.0" encoding="UTF-8"?>
<!-- ABOUTME: launchd agent that runs `toggl-heartbeat flush` every 15 minutes. -->
<!-- ABOUTME: __HOME__ is replaced with $HOME at install time (see README). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cotellese.toggl-heartbeat</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/scripts/toggl-heartbeat/.venv/bin/python</string>
        <string>-m</string>
        <string>toggl_heartbeat</string>
        <string>flush</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/toggl-heartbeat/flush.log</string>
</dict>
</plist>
