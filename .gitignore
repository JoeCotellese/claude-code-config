# ABOUTME: Git ignore file for claude-code-config repo.
# ABOUTME: Excludes local project settings and any machine-specific files.

# Local project settings directory (Claude Code runtime files)
.claude/

# Machine-local settings (if ever added to repo root)
settings.json
settings.local.json

# Skill-specific local config (contains rclone remotes, paths, etc.)
skills/*/config.json
plugins/*/skills/*/config.json

# Python bytecode caches
__pycache__/
*.pyc

# Bonnie Ravina / Full Circle 360 Marketing proprietary framework — not ours to publish
skills/positioning/
